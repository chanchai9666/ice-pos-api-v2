# Application Configuration
APP_NAME="ICE POS API v2"
APP_ENV=development
APP_PORT=8080
ALLOW_ORIGIN=*
SWAGGER_HOST=localhost:8080

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-ice-pos-v2

# Database Configuration
DB_TYPE=sqlite
DB_PATH=ice_pos_v2.db

# Remote PostgreSQL (if used)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ice_pos_v2
DB_SSLMODE=disable

# File Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# Storage & ImageKit Configuration
STORAGE_DRIVER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/pos
